# ─── Dependency-install policy ───
# Pin exact versions on `pnpm add`. Prevents a caret-range install from
# silently pulling a compromised newer patch (the pattern behind several
# recent npm supply-chain attacks).
save-exact=true

# Refuse to install if the lockfile and package.json disagree. Catches the
# case where a manifest edit bypasses review by not updating the lock.
prefer-frozen-lockfile=true

# Warn when package engine requirements don't match. Prevents pulling a
# Node-version-specific binary that could behave differently locally.
engine-strict=true

# ─── pnpm hoist/compat ───
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
