# Copy to `.env.local` and fill in real values. `pnpm build` validates required keys via `src/env.js`.

# Required (server)
DATABASE_URL=postgresql://localhost:5432/postgres
SERVER_URL=http://localhost:3000
UNIBLOCK_API_URL=https://example.com
UNIBLOCK_API_KEY=replace-me

# Required for static generation (Privy validates app ID at build time)
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_PERP_HEDGE_API_URL=http://localhost:9090/api

# Privy signer id from dashboard (server-side signing for Pacifica / Wallet API). If unset, the app
# will prompt once via delegateWallet instead.
# NEXT_PUBLIC_SIGNER_ID=

# Supabase — optional for `next build` (lazy client); needed at runtime for vaults + /api/realized-yield
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Solana RPC — optional; defaults to public mainnet/devnet if omitted
# NEXT_PUBLIC_SOLANA_RPC_MAINNET=
# NEXT_PUBLIC_SOLANA_RPC_MAINNET_WSS=
# NEXT_PUBLIC_SOLANA_RPC_DEVNET=
# NEXT_PUBLIC_SOLANA_RPC_DEVNET_WSS=

# Docker / CI without full schema: SKIP_ENV_VALIDATION=1
